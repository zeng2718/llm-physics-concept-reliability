# Copy this file to .env and supply only the credentials needed for the model
# route being run. Never commit the populated .env file.

# Local directories containing the restricted concept-inventory and variant
# item files. These materials are intentionally absent from the public package.
PHYS_QB_ITEM_DIR=
PHYS_QB_VARIANT_DIR=

MOONSHOT_API_KEY=
# The default endpoint is https://api.moonshot.cn/v1. Set the following only
# when using a different account region.
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# The three variables below held separate OpenRouter credentials during the
# study. All are intentionally blank in this template.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
